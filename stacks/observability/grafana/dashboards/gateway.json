{
  "uid": "gateway",
  "title": "Gateway",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "tags": [
    "solar-llm-serving"
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests / s",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(gateway_requests[1m])",
          "legendFormat": "requests",
          "refId": "A"
        },
        {
          "expr": "rate(gateway_bedrock_fallbacks[1m])",
          "legendFormat": "bedrock fallbacks",
          "refId": "B"
        },
        {
          "expr": "rate(gateway_rejected[1m])",
          "legendFormat": "rejected",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens / s",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(gateway_prompt_tokens[1m])",
          "legendFormat": "prompt",
          "refId": "A"
        },
        {
          "expr": "rate(gateway_completion_tokens[1m])",
          "legendFormat": "completion",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upstream queue depth",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "gateway_upstream_waiting",
          "legendFormat": "{{upstream}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Upstream up",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "gateway_upstream_up",
          "legendFormat": "{{upstream}}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  }
}
