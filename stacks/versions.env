# Image pins. Every compose file and the Helm values read these names.
# Pinned 2026-09-19 from the vendors' tag lists; bump deliberately, one at a time, and re-run the harness.
VLLM_IMAGE=vllm/vllm-openai:v0.11.0
SGLANG_IMAGE=lmsysorg/sglang:v0.5.3-cu126
TRTLLM_BUILD_IMAGE=nvcr.io/nvidia/tensorrt-llm/release:1.1.0
TRITON_TRTLLM_IMAGE=nvcr.io/nvidia/tritonserver:25.09-trtllm-python-py3
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.2.3-4.1.3-ubuntu22.04
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.1.0
MODEL_FP16=Qwen/Qwen3-8B
MODEL_AWQ=Qwen/Qwen3-8B-AWQ
HF_CACHE=/data/hf
